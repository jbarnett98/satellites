{
  "name": "atmospheric-perspective",
  "private": true,
  "version": "0.1.0",
  "description": "Atmospheric Perspective — a real-time globe of everything in Earth orbit. Root scripts delegate to web/ and pipeline/.",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "check": "npm --prefix web run check",
    "textures": "uv run --directory pipeline python -m ap_pipeline.textures.build_earth_textures_from_nasa",
    "stars": "uv run --directory pipeline python -m ap_pipeline.sky.build_star_catalog_from_hyg",
    "milkyway": "uv run --directory pipeline python -m ap_pipeline.sky.build_milky_way_glow_from_tycho2",
    "orbits": "uv run --directory pipeline python -m ap_pipeline.orbits.run_orbit_update",
    "orbits:status": "uv run --directory pipeline python -m ap_pipeline.orbits.run_orbit_update --status",
    "orbits:rebuild": "uv run --directory pipeline python -m ap_pipeline.orbits.run_orbit_update --rebuild",
    "orbits:schedule": "powershell -ExecutionPolicy Bypass -File pipeline/scheduling/register_windows_task.ps1",
    "orbits:schedule:status": "powershell -ExecutionPolicy Bypass -File pipeline/scheduling/register_windows_task.ps1 -Status",
    "orbits:unschedule": "powershell -ExecutionPolicy Bypass -File pipeline/scheduling/register_windows_task.ps1 -Remove"
  }
}
